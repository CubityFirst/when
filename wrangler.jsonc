// cloudflare.config.ts is the source of truth: `cf dev` and `cf deploy` ignore this file.
// It stays only for the Wrangler commands that still read it (`npm run db:local`,
// `npm run db:remote`, `npx wrangler d1 execute`, `npx wrangler tail`). Keep the two in
// sync until those move to cf, then delete this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "when",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "d843ae90cab33e54f4d284bc65d2fd6a",
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "when.cubityfir.st",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the worker so group and event links get link previews.
    "run_worker_first": ["/*", "!/assets/*", "!/brand/*", "!/favicon.svg"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "when-db",
      "database_id": "9d2bf78a-701f-408e-a677-2e3e9e2f5d95"
    }
  ]
}
